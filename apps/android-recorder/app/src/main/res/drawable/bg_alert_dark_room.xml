<?xml version="1.0" encoding="utf-8"?>
<!-- "Dark room" backdrop: a radial glow fading into near-black, so the
     lit phone card reads as sitting in a dark space. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="640"
        android:centerX="0.5"
        android:centerY="0.4"
        android:startColor="#1A1A1F"
        android:centerColor="#0E0E12"
        android:endColor="#000000" />
</shape>
