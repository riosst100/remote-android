<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep the control-plane connection (WebSocket) alive; recording itself
         relies on the foreground service, not on wake locks, per the design
         goal that WebSocket connectivity must not gate audio capture. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Used only to prompt the user to exempt the app from OEM battery
         optimization; this opens system settings and never bypasses the
         user's decision. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".RecorderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.RecorderAgent"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- Single setup/status screen: grant permissions, see registration
             and connection status. Not a "normal" app UI — there is nothing
             here to browse recordings or trigger recording; that all happens
             from the Laravel dashboard. Still needs a launcher entry so the
             device owner can complete setup and Android can show it under
             Settings -> Apps, per the no-stealth requirement. -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".recording.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".boot.BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
