<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Full-screen alert popup (SHOW_ALERT command): the alert activity is
         launched via a full-screen-intent notification so it can appear over
         the lock screen like an incoming call/alarm. VIBRATE accompanies the
         alarm sound. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets the background service force the alert activity to the front
         over any other app (not just over the lock screen). The user must
         enable "Display over other apps" once in Settings (see
         SetupActivity); never granted silently. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep the control-plane connection (WebSocket) alive; recording itself
         relies on the foreground service, not on wake locks, per the design
         goal that WebSocket connectivity must not gate audio capture. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Used only to prompt the user to exempt the app from OEM battery
         optimization; this opens system settings and never bypasses the
         user's decision. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Device-authoritative recording schedule (see ScheduleAlarmScheduler):
         SCHEDULE_EXACT_ALARM is the runtime-revocable permission this
         general-purpose app requests explicitly (SetupActivity); it does
         not qualify for the "core app function" auto-grant categories that
         USE_EXACT_ALARM covers on API 33+, so both are declared and the
         request/fallback-poll path is treated as the primary path. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".RecorderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.RecorderAgent"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- Single setup/status screen: grant permissions, see registration
             and connection status. Not a "normal" app UI — there is nothing
             here to browse recordings or trigger recording; that all happens
             from the Laravel dashboard. Still needs a launcher entry so the
             device owner can complete setup and Android can show it under
             Settings -> Apps, per the no-stealth requirement. -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alert popup (SHOW_ALERT). Launched from a
             full-screen-intent notification; shows over the lock screen and
             excluded from recents so it behaves like a transient alarm. -->
        <activity
            android:name=".ui.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:taskAffinity=".alert"
            android:theme="@style/Theme.RecorderAgent" />

        <service
            android:name=".recording.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <receiver
            android:name=".boot.BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".boot.ScheduleAlarmReceiver"
            android:exported="false" />

    </application>

</manifest>
